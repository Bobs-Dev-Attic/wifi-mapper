<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WiFi scanning. Reading scan results requires location permission on all
         supported versions; NEARBY_WIFI_DEVICES is the Android 13+ replacement
         that lets us declare we don't derive physical location from WiFi. We
         still request location because we DO use GPS for the geo-anchor. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        tools:targetApi="tiptoe" />

    <!-- ARCore uses the camera for visual-inertial tracking. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- In-app auto-update: fetch release metadata, download + install the APK. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Bluetooth LE scanning for the networks list and radar. Android 12+ uses
         BLUETOOTH_SCAN (runtime); older versions use the legacy permissions plus
         location. We don't claim neverForLocation: RSSI is used to locate devices. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <!-- Read the names of paired devices for "Find my device" (Android 12+). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Tracker radar: buzz when the ping reaches the blip (normal permission, auto-granted). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Barometer. Not all devices have one; we handle absence at runtime. -->
    <uses-feature android:name="android.hardware.sensor.barometer"
        android:required="false" />
    <uses-feature android:name="android.hardware.camera.ar"
        android:required="false" />
    <uses-feature android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".WifiMapperApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WifiMapper">

        <!-- "optional" => app installs on non-AR devices; we check availability
             at runtime and fall back to GPS+barometer-only capture. -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.WifiMapper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves the downloaded APK to the system installer via a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
